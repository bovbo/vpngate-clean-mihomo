# 主节点浏览器 / OpenVPN Worker
# 部署前复制为 worker/wrangler.toml，并按需绑定同一个 GATE_KV namespace。
name = "vpngate-clean-mihomo"
main = "worker.js"
compatibility_date = "2026-07-08"

# 可选：绑定自己的自定义域名
# [[routes]]
# pattern = "sub.example.com"
# custom_domain = true

# 可选：启用 SSTP 数据聚合与 /nodes.txt 读取。
# 将 id 替换为 SSTP 发布 Worker 所使用的同一个 KV namespace ID。
# [[kv_namespaces]]
# binding = "GATE_KV"
# id = "REPLACE_WITH_KV_NAMESPACE_ID"
