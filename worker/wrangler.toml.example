# 唯一主 Worker：节点浏览器 + OpenVPN + SSTP 检测/发布
name = "vpngate-clean-mihomo"
main = "worker.js"
compatibility_date = "2026-07-08"

# SSTP 检测由本 Worker 的 Cron 触发；有未完成任务时每 10 分钟续跑。
[triggers]
crons = ["*/10 * * * *"]

[vars]
INTERVAL_MINUTES = "60"
STEP_SECONDS = "300"
CHECK_CONCURRENCY = "6"
SUBREQUEST_LIMIT = "45"
CHECK_WORKER = "check.boxo.eu.org"

# 必须绑定 KV：SSTP 检测结果、data.json 和 nodes.txt 均由本 Worker 写入/读取。
# 将 id 替换成你现有的 GATE_KV namespace ID。
[[kv_namespaces]]
binding = "GATE_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

# 可选：绑定原有主站自定义域名
# [[routes]]
# pattern = "你的主站域名"
# custom_domain = true
